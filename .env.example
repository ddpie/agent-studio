# Agent Studio Configuration
#
# One-click deploy: ./deploy-all.sh --region us-east-1
# This file is auto-generated by deploy-all.sh after deployment.
#
# Manual setup (without deploy-all.sh):
# Fill in the values below, then run CDK + deploy scripts separately.

# Required for CDK deploy
AGENT_STUDIO_REGION=us-east-1
AGENT_STUDIO_ACCOUNT_ID=123456789012
AGENT_STUDIO_S3_BUCKET=bedrock-agentcore-codebuild-sources-123456789012-us-east-1
ORIGIN_VERIFY_SECRET=<generate with: openssl rand -hex 32>

# Auto-populated by deploy-all.sh (or fill manually for existing resources)
AGENT_STUDIO_META_AGENT_ID=
AGENT_STUDIO_COGNITO_USER_POOL_ID=
AGENT_STUDIO_COGNITO_CLIENT_ID=
AGENT_STUDIO_CLOUDFRONT_DOMAIN=
AGENT_STUDIO_API_URL=
AGENT_STUDIO_FRONTEND_BUCKET=
AGENT_STUDIO_CLOUDFRONT_ID=
